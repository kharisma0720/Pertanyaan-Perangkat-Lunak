concl('insight', `${pc(mid+hard)} pertanyaan berada di level menengah–sulit, sedangkan level mudah hanya ${fmt(easy)} soal (${pc(easy)}). Kumpulan soal ini lebih cocok untuk latihan tingkat menengah ke atas, misalnya persiapan wawancara, dan kurang cocok sebagai bahan pengenalan bagi pemula.`);
concl('c2', `${Object.keys(categoryCounts).length} kategori tercatat. ${big.length} kategori memiliki minimal 10 pertanyaan (cukup untuk dianalisis), sedangkan ${small.length} kategori berisi ${fmt(smallN)} pertanyaan saja (${pc(smallN)} data) sehingga persentasenya kurang andal. Beberapa nama kategori juga bertumpang tindih (lihat Diagram 4 dan Diagram 9).`);
 
/* ---- Diagram 3: peta panas ---- */
const xt = {};
rows.forEach(r => { const c=r[categoryKey], d=r[difficultyKey]; (xt[c] = xt[c] || {Mudah:0,Menengah:0,Sulit:0})[d]++; });
$('hmBody').innerHTML = sortedCats.map(([name,n]) => {
  const x = xt[name];
  const cells = DIFFS.map(d => { const v=x[d], share=v/n; return v
    ? `<td class="c" style="background:color-mix(in srgb, ${DCOL[d]} ${Math.round(share*75)}%, transparent)">${fmt(v)}</td>`
    : `<td class="c" style="color:var(--muted);font-weight:400">·</td>`; }).join('');
  return `<tr><td>${E(name)}</td>${cells}<td class="c">${fmt(n)}</td><td class="c">${pc(x.Sulit,n)}</td></tr>`;
}).join('');
const allHard = sortedCats.filter(([n,t]) => xt[n].Sulit === t);
const bigRank = big.map(([n,t]) => [n, xt[n].Sulit/t, t]).sort((a,b)=>b[1]-a[1]);
const hi = bigRank[0], lo = bigRank[bigRank.length-1];
const psHard = xt['Perancangan Sistem'] ? xt['Perancangan Sistem'].Sulit/xt['Perancangan Sistem'].Menengah : 0;
concl('c3', `${allHard.length} kategori (${fmt(sum(allHard.map(x=>x[1])))} soal) seluruhnya berlevel Sulit, antara lain ${allHard.slice(0,4).map(x=>E(x[0])).join(', ')}. Di antara kategori besar (≥10 soal), ${E(hi[0])} paling berat (${pc(hi[1]*100,100)} sulit) dan ${E(lo[0])} paling ringan (${pc(lo[1]*100,100)} sulit). Tingkat kesulitan jelas tidak merata antarkategori: topik teori dan sistem tingkat lanjut didominasi soal sulit, sedangkan topik praktik harian didominasi soal menengah.`);
 
/* ---- Diagram 4: donut bidang ---- */
const fieldCounts = {};
rows.forEach(r => { const f=fieldOf(r); fieldCounts[f]=(fieldCounts[f]||0)+1; });
const fieldList = Object.entries(fieldCounts).sort((a,b)=>b[1]-a[1]);
const R = 70, C = 2*Math.PI*R; let off = 0;
const arcs = fieldList.map(([name,n],i) => { const len=n/total*C; const s=`<circle r="${R}" cx="100" cy="100" fill="none" stroke="${PAL[i%PAL.length]}" stroke-width="32" stroke-dasharray="${len} ${C-len}" stroke-dashoffset="${-off}" transform="rotate(-90 100 100)"><title>${E(name)}: ${n}</title></circle>`; off+=len; return s; }).join('');
$('donut').innerHTML = `<svg viewBox="0 0 200 200" role="img" aria-label="Donut komposisi bidang">${arcs}<text x="100" y="98" text-anchor="middle" font-size="26" font-weight="800" fill="currentColor">${fmt(total)}</text><text x="100" y="118" text-anchor="middle" font-size="11" fill="currentColor" opacity=".6">pertanyaan</text></svg>`
  + `<div class="legend">${fieldList.map(([name,n],i)=>`<div><span><i class="sw" style="background:${PAL[i%PAL.length]}"></i>${E(name)}</span><span>${fmt(n)} · ${pc(n)}</span></div>`).join('')}</div>`;
const f1=fieldList[0], f2=fieldList[1], fl=fieldList[fieldList.length-1];
concl('c4', `setelah ${Object.keys(categoryCounts).length} kategori digabung menjadi ${fieldList.length} bidang, <strong>${E(f1[0])}</strong> menjadi yang terbesar (${fmt(f1[1])} soal, ${pc(f1[1])}), disusul ${E(f2[0])} (${pc(f2[1])}). Bidang ${E(fl[0])} paling kecil (${fmt(fl[1])} soal, ${pc(fl[1])}) sehingga belum cukup mewakili topiknya. Penggabungan ini juga memperlihatkan bahwa banyak kategori awal sebenarnya satu bidang yang sama.`);
 
/* ---- Diagram 5: waffle ---- */
$('waffleUnit').textContent = dec(total/100);
const raw = DIFFS.map(d => (difficultyCounts[d]||0)/total*100);
const cellN = raw.map(Math.floor); let left = 100 - sum(cellN);
raw.map((v,i)=>[v-Math.floor(v),i]).sort((a,b)=>b[0]-a[0]).slice(0,left).forEach(([,i])=>cellN[i]++);
let wf = ''; DIFFS.forEach((d,i)=>{ for(let k=0;k<cellN[i];k++) wf += `<i style="background:${DCOL[d]}" title="${d}"></i>`; });
$('waffle').innerHTML = `<div class="waffle">${wf}</div><div class="legend">${DIFFS.map((d,i)=>`<div><span><i class="sw" style="background:${DCOL[d]}"></i>${d}</span><span>${fmt(difficultyCounts[d]||0)} · ${pc(difficultyCounts[d]||0)}</span></div>`).join('')}</div>`;
concl('c5', `dari 100 kotak, sekitar ${cellN[1]} berwarna menengah dan ${cellN[2]} sulit, sedangkan kotak mudah hanya ${pc(easy)} dari total. Soal sulit sekitar ${dec(hard/Math.max(1,easy))} kali lebih banyak daripada soal mudah, sehingga komposisi ini timpang ke level atas dan tidak memiliki jenjang pemanasan yang memadai.`);
 
/* ---- Diagram 6: panjang jawaban ---- */
const wc = t => (String(t).trim().match(/\S+/g)||[]).length;
const lenBy = {}; DIFFS.forEach(d => lenBy[d] = rows.filter(r=>r[difficultyKey]===d).map(r=>wc(r[answerKey])));
const lenMax = Math.max(1, ...DIFFS.map(d=>mean(lenBy[d])));
$('lenChart').innerHTML = DIFFS.map(d => { const a=lenBy[d]; return `<div class="difficulty-item"><div class="diff-head"><strong>${d}</strong><span>rata-rata ${dec(mean(a))} kata <span class="lens-note">median ${dec(median(a))} · rentang ${Math.min(...a)}–${Math.max(...a)}</span></span></div><div class="diff-track"><div class="diff-fill" style="width:${mean(a)/lenMax*100}%;background:${DCOL[d]}"></div></div></div>`; }).join('');
const allLen = rows.map(r=>wc(r[answerKey]));
const mM = mean(lenBy.Menengah), mS = mean(lenBy.Sulit);
concl('c6', `rata-rata jawaban hanya ${dec(mean(allLen))} kata (sekitar satu–dua kalimat). Jawaban soal Sulit rata-rata ${dec(mS)} kata, ${mS<mM?'lebih pendek':'lebih panjang'} daripada soal Menengah (${dec(mM)} kata), jadi panjang jawaban bukan penanda tingkat kesulitan. Jawaban bersifat ringkas, cocok sebagai kunci cepat tetapi belum cukup mendalam untuk topik sulit.`);
 
/* ---- Diagram 7: jenis kata tanya ---- */
const QFIX = {rancangn:'rancang',buatn:'buat',kembangkann:'kembangkan'};
const qWord = r => { let w=(String(r[questionKey]).trim().split(/\s+/)[0]||'').replace(/[^\p{L}]/gu,'').toLowerCase(); w=QFIX[w]||w; return w ? w[0].toUpperCase()+w.slice(1) : '(kosong)'; };
const qc = {}; rows.forEach(r => { const w=qWord(r); qc[w]=(qc[w]||0)+1; });
const qList = Object.entries(qc).sort((a,b)=>b[1]-a[1]);
const qTop = qList.slice(0,8), qRest = sum(qList.slice(8).map(x=>x[1]));
const qShow = qRest ? [...qTop,['Lainnya',qRest]] : qTop;
const qMax = Math.max(1,...qShow.map(x=>x[1]));
$('qwChart').innerHTML = qShow.map(([n,v])=>`<div class="chart-row"><div class="chart-label">${E(n)}</div><div class="bar-bg"><div class="bar" style="width:${v/qMax*100}%"></div></div><div class="count">${fmt(v)}</div></div>`).join('');
const CONCEPT = new Set(['Apa','Jelaskan','Bagaimana','Bisakah','Discuss','Mengapa','Explain','What','How']);
const conceptN = sum(qList.filter(([n])=>CONCEPT.has(n)).map(x=>x[1])), practN = total-conceptN;
concl('c7', `${fmt(conceptN)} pertanyaan (${pc(conceptN)}) berbentuk penjelasan konsep (Apa, Jelaskan, Bagaimana), sedangkan ${fmt(practN)} (${pc(practN)}) berupa tugas rancang atau implementasi. "${E(qList[0][0])}" dan "${E(qList[1][0])}" saja sudah menyumbang ${pc(qList[0][1]+qList[1][1])} data. Data ini lebih banyak menguji pemahaman teori daripada kemampuan praktik.`);
 
/* ---- Diagram 8: awan istilah ---- */
const TERMS = [
  ['API',/\bapi\b/i],['REST',/\brest(ful)?\b/i],['Docker',/docker/i],['Kubernetes',/kubernetes/i],['CI/CD',/ci\/cd|continuous (integration|deployment|delivery)/i],
  ['Microservices',/microservice/i],['SQL',/\bsql\b/i],['NoSQL',/nosql/i],['Cache',/cach/i],['Database',/database|basis data/i],['Git',/\bgit\b/i],
  ['React',/\breact\b/i],['JavaScript',/javascript/i],['Python',/python/i],['Load balancer',/load.?balanc/i],['Skalabilitas',/scal|skala/i],
  ['Keamanan',/secur|keamanan|enkripsi|encrypt|xss|csrf|injection/i],['Testing',/\btest|pengujian/i],['Cloud',/cloud/i],['Autentikasi',/authenticat|autentikasi|oauth|jwt/i],
  ['Algoritma',/algorit/i],['OOP',/\boop\b|polimorf|enkapsulasi|pewarisan|inheritance/i],['Konkurensi',/concurren|thread|async|asinkron|race condition|deadlock/i],
  ['Machine learning',/machine learning|pembelajaran mesin|neural/i],['HTTP',/\bhttps?\b/i],['Indexing',/index/i],['Design pattern',/design pattern|singleton|factory|observer|\bmvc\b/i],
  ['Monitoring',/monitor|logging/i],['Infrastructure as Code',/infrastructure as code|\biac\b|terraform/i],['Memori',/memory|memori|garbage/i],['HTML/CSS',/\bcss\b|\bhtml\b/i],
  ['Struktur data',/hash|\btree\b|pohon|graph|graf|linked list|stack|queue|array/i],['Sorting',/\bsort|pengurutan/i]
];
const termCounts = TERMS.map(([n,re]) => [n, rows.filter(r=>re.test(r[questionKey]+' '+r[answerKey])).length]).filter(x=>x[1]>0).sort((a,b)=>b[1]-a[1]).slice(0,26);
const tMax = termCounts[0][1], tMin = termCounts[termCounts.length-1][1];
$('cloud').innerHTML = termCounts.map(([n,v]) => { const sz = 13 + (tMax===tMin?0:(Math.sqrt(v)-Math.sqrt(tMin))/(Math.sqrt(tMax)-Math.sqrt(tMin))*22); return `<span style="font-size:${sz.toFixed(1)}px" title="${E(n)}: ${v} baris">${E(n)}</span>`; }).join('');
const tt = termCounts.slice(0,3);
const tc = n => (termCounts.find(x=>x[0]===n)||[n,0])[1];
const top5 = termCounts.slice(0,5);
concl('c8', `lima istilah teratas adalah ${top5.map(([n,v])=>`<strong>${E(n)}</strong> (${v} baris)`).join(', ')}. Artinya fokus soal ada pada skalabilitas sistem, dasar komputasi (algoritma dan struktur data), basis data, serta keamanan, sedangkan nama alat spesifik seperti Docker (${tc('Docker')} baris), React (${tc('React')}), dan Git (${tc('Git')}) jarang disebut langsung. Istilah dihitung dari daftar kata kunci yang dipilih, bukan seluruh kosakata.`);
 
/* Perkiraan pertanyaan berbahasa campuran (dipakai pada audit) */
const ENW = new Set('the a an in of to and is are how does do what why for with from vs versus compared between using use on at by its it their can you your or as that this be which when into more than'.split(' '));
const enCount = t => (String(t).toLowerCase().match(/[a-z']+/g)||[]).filter(w=>ENW.has(w)).length;
const mixQ = rows.filter(r=>enCount(r[questionKey])>=1).length;
 
/* ---- Diagram 9: audit ---- */
const norm = s => String(s).toLowerCase().replace(/\s+/g,' ').trim();
const groups = {}; rows.forEach(r => (groups[norm(r[questionKey])] = groups[norm(r[questionKey])] || []).push(r));
const dupGroups = Object.values(groups).filter(g=>g.length>1).sort((a,b)=>b.length-a.length);
const unique = Object.keys(groups).length, dupRows = total - unique;
const inconsistent = dupGroups.filter(g => new Set(g.map(r=>r[categoryKey]+'|'+r[difficultyKey])).size > 1).length;
$('auditMetrics').innerHTML = [
  ['Baris duplikat',fmt(dupRows),pc(dupRows)+' dari seluruh data'],
  ['Pertanyaan unik',fmt(unique),'dari '+fmt(total)+' baris'],
  ['Kategori ≤3 soal',fmt(small.length),fmt(smallN)+' pertanyaan'],
  ['Pertanyaan campuran bahasa',fmt(mixQ),pc(mixQ)+' dari pertanyaan']
].map(x=>`<div class="metric"><small>${x[0]}</small><strong>${x[1]}</strong><span>${x[2]}</span></div>`).join('');
$('dupBody').innerHTML = dupGroups.map(g => { const labels=[...new Set(g.map(r=>r[categoryKey]+' / '+r[difficultyKey]))]; return `<tr><td style="min-width:260px">${E(g[0][questionKey])}</td><td class="c">${g.length}×</td><td>${g.map(r=>E(r[noKey])).join(', ')}</td><td>${labels.length===1?'<span class="pill">Konsisten</span>':'<span class="pill difficulty">Berbeda: '+labels.map(E).join(' | ')+'</span>'}</td></tr>`; }).join('') || '<tr><td colspan="4" class="empty">Tidak ada duplikat.</td></tr>';
const OVER = [['Pemrograman Umum','General Program'],['Database and SQL','Sistem Basis Data'],['Pembelajaran Mesin','Kecerdasan Buatan']].filter(p=>p.every(c=>c in categoryCounts));
$('overlapList').innerHTML = OVER.map(p=>`<li>Kategori <strong>${E(p[0])}</strong> dan <strong>${E(p[1])}</strong> tampak berbicara tentang topik yang sama.</li>`).join('')
  + `<li>Kategori <strong>Front-end</strong>, <strong>Back-end</strong>, <strong>Full-stack</strong>, <strong>Web Development</strong>, dan <strong>Languages and Frameworks</strong> saling beririsan.</li><li>Nama kategori bercampur bahasa Indonesia dan Inggris (mis. "Software Testing" dengan "Pembelajaran Mesin").</li>`;
concl('c10', `${fmt(dupRows)} baris (${pc(dupRows)}) adalah pengulangan sehingga hanya ada ${fmt(unique)} pertanyaan unik; ${fmt(inconsistent)} dari ${fmt(dupGroups.length)} kelompok duplikat bahkan memiliki label kategori atau kesulitan yang berbeda. Duplikasi membuat frekuensi kategori membengkak, ${small.length} kategori terlalu tipis, dan soal Mudah sangat sedikit. Data sebaiknya dibersihkan dan diseimbangkan sebelum dipakai untuk analisis atau ujian.`);
 
/* ---- Mode belajar: flashcard ---- */
const fcCat=$('fcCat'), fcDiff=$('fcDiff');
Object.keys(categoryCounts).sort((a,b)=>a.localeCompare(b,'id')).forEach(c=>fcCat.add(new Option(c,c)));
Object.keys(difficultyCounts).sort((a,b)=>a.localeCompare(b,'id')).forEach(d=>fcDiff.add(new Option(d,d)));
let deck=[], di=0, flip=false; const grade={};
function setDeck(list){ deck=list; di=0; flip=false; drawFlash(); }
function filterDeck(shuf){ let l=rows.filter(r=>(!fcCat.value||r[categoryKey]===fcCat.value)&&(!fcDiff.value||r[difficultyKey]===fcDiff.value)); if(shuf) shuffleArr(l); setDeck(l); }
function balancedSet(n){ const g={}; rows.forEach(r=>(g[fieldOf(r)]=g[fieldOf(r)]||[]).push(r)); Object.values(g).forEach(shuffleArr); const keys=Object.keys(g), out=[]; let i=0; while(out.length<n && keys.some(k=>g[k].length)){ const k=keys[i%keys.length]; if(g[k].length) out.push(g[k].pop()); i++; } return shuffleArr(out); }
function drawFlash(){
  const card=$('flashCard');
  if(!deck.length){ card.className='flashcard'; card.innerHTML='<div class="empty">Tidak ada kartu untuk filter ini.</div>'; $('flashStats').innerHTML=''; concl('flashConcl','ubah filter kategori atau tingkat kesulitan untuk menampilkan kartu.','Kesimpulan sesi:'); return; }
  const r=deck[di], g=grade[r[noKey]];
  card.className='flashcard'+(flip?' back':'');
  card.innerHTML = flip
    ? `<div class="fl-tag">Jawaban</div><div class="fl-text">${E(r[answerKey])}</div>${g?`<div class="fl-hint">Penilaian Anda: ${g==='ok'?'Paham':'Belum'}</div>`:''}`
    : `<div class="fl-meta"><span class="pill">${E(r[categoryKey])}</span><span class="pill difficulty">${E(r[difficultyKey])}</span></div><div class="fl-text q">${E(r[questionKey])}</div><div class="fl-hint">Klik kartu untuk melihat jawaban</div>`;
  const ok=deck.filter(x=>grade[x[noKey]]==='ok').length, no=deck.filter(x=>grade[x[noKey]]==='no').length, done=ok+no;
  $('flashStats').innerHTML = `Kartu ${fmt(di+1)} dari ${fmt(deck.length)} · Paham ${fmt(ok)} · Belum ${fmt(no)}<div class="progress"><div style="width:${done/deck.length*100}%"></div></div>`;
  if(!done){ concl('flashConcl','belum ada kartu yang dinilai. Balik kartu, lalu tandai <em>Paham</em> atau <em>Belum</em>; ringkasan sesi akan muncul di sini.','Kesimpulan sesi:'); }
  else {
    const weak={}; deck.forEach(x=>{ if(grade[x[noKey]]==='no') weak[x[categoryKey]]=(weak[x[categoryKey]]||0)+1; });
    const wl=Object.entries(weak).sort((a,b)=>b[1]-a[1]);
    concl('flashConcl', `dari ${fmt(done)} kartu yang dinilai, ${fmt(ok)} dipahami (${pc(ok,done)}) dan ${fmt(no)} perlu diulang. ${wl.length?'Kategori yang paling perlu diulang: <strong>'+E(wl[0][0])+'</strong> ('+wl[0][1]+' kartu).':'Semua kartu yang dinilai sudah dipahami.'}`,'Kesimpulan sesi:');
  }
}
const flipCard=()=>{ if(!deck.length) return; flip=!flip; drawFlash(); };
const go=d=>{ if(!deck.length) return; di=(di+d+deck.length)%deck.length; flip=false; drawFlash(); };
const rate=v=>{ if(!deck.length) return; grade[deck[di][noKey]]=v; if(di<deck.length-1){ di++; } flip=false; drawFlash(); };
$('flashCard').addEventListener('click',flipCard);
$('flashCard').addEventListener('keydown',e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); flipCard(); } else if(e.key==='ArrowRight') go(1); else if(e.key==='ArrowLeft') go(-1); });
$('fcFlip').addEventListener('click',flipCard); $('fcPrev').addEventListener('click',()=>go(-1)); $('fcNext').addEventListener('click',()=>go(1));
$('fcOk').addEventListener('click',()=>rate('ok')); $('fcNo').addEventListener('click',()=>rate('no'));
fcCat.addEventListener('change',()=>filterDeck(false)); fcDiff.addEventListener('change',()=>filterDeck(false));
$('fcShuffle').addEventListener('click',()=>filterDeck(true));
$('fcBalanced').addEventListener('click',()=>{ fcCat.value=''; fcDiff.value=''; setDeck(balancedSet(20)); });
filterDeck(true);
 
/* ---- Kesimpulan akhir (diperluas) ---- */
$('conclusion').insertAdjacentHTML('afterend', `<ul style="line-height:1.7;margin:12px 0 0;padding-left:20px"><li><strong>Sebaran:</strong> bidang terbesar adalah ${E(f1[0])} (${pc(f1[1])}); ${small.length} kategori sangat tipis (≤3 soal).</li><li><strong>Kesulitan:</strong> ${pc(mid+hard)} soal berlevel menengah–sulit, dan ${E(allHard.length+'')} kategori seluruhnya sulit.</li><li><strong>Bentuk soal:</strong> ${pc(conceptN)} berupa penjelasan konsep; jawaban rata-rata ${dec(mean(allLen))} kata.</li><li><strong>Kualitas data:</strong> ${fmt(dupRows)} baris duplikat, ${pc(mixQ)} pertanyaan berbahasa campuran, dan beberapa kategori saling tumpang tindih.</li></ul>`);
 
</script>
</body>
