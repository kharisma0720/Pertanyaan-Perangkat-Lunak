<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard Data Pertanyaan Perangkat Lunak</title>
<style>
:root{--bg:#f5f7fb;--panel:#fff;--text:#172033;--muted:#667085;--line:#e6eaf2;--accent:#6759e8;--accent2:#13b8a6;--soft:#efedff;--shadow:0 12px 34px rgba(24,32,58,.07)}
body.dark{--bg:#111827;--panel:#1b2536;--text:#f1f5f9;--muted:#aab6c8;--line:#334155;--accent:#a69cff;--accent2:#41d7c5;--soft:#302c51;--shadow:0 12px 34px rgba(0,0,0,.18)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;transition:.2s}
.wrap{max-width:1400px;margin:auto;padding:28px 22px 50px}.hero{background:linear-gradient(125deg,#27245f,#6558e8 62%,#22b8a8);color:white;border-radius:24px;padding:30px;position:relative;overflow:hidden;box-shadow:var(--shadow)}
.hero:after{content:"";position:absolute;width:250px;height:250px;border:40px solid #ffffff18;border-radius:50%;right:-45px;top:-95px}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:11px;font-weight:800;opacity:.8}.hero h1{font-size:clamp(26px,4vw,42px);line-height:1.12;margin:12px 0}.hero p{max-width:740px;margin:0;color:#eeedff;line-height:1.65}.topbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.brand{font-weight:800;letter-spacing:-.03em}.actions{display:flex;gap:8px;flex-wrap:wrap}button,.btn{border:1px solid var(--line);background:var(--panel);color:var(--text);padding:10px 13px;border-radius:11px;font-weight:700;cursor:pointer;text-decoration:none;font-size:13px}button:hover,.btn:hover{transform:translateY(-1px);border-color:var(--accent)}.hero button{background:#ffffff1c;color:white;border-color:#ffffff55}
.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:18px 0}.metric,.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:18px;box-shadow:var(--shadow)}.metric small{color:var(--muted);font-weight:700}.metric strong{display:block;font-size:30px;margin:8px 0 4px;letter-spacing:-.04em}.metric span{font-size:12px;color:var(--muted)}.layout{display:grid;grid-template-columns:1.15fr .85fr;gap:16px}.panel h2{font-size:17px;margin:0 0 4px}.sub{font-size:12px;color:var(--muted);margin:0 0 18px}.chart-row{display:grid;grid-template-columns:minmax(120px,1.3fr) minmax(80px,2fr) 42px;gap:10px;align-items:center;margin:12px 0;font-size:12px}.chart-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bar-bg{height:10px;border-radius:99px;background:var(--line);overflow:hidden}.bar{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--accent),var(--accent2))}.count{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}.difficulty-item{margin:18px 0}.diff-head{display:flex;justify-content:space-between;gap:10px;font-size:13px;margin-bottom:8px}.diff-track{height:14px;background:var(--line);border-radius:99px;overflow:hidden}.diff-fill{height:100%;border-radius:99px}.diff-mudah{background:#26b99a}.diff-menengah{background:#7566ed}.diff-sulit{background:#f59e0b}.insight{border-radius:14px;padding:14px;background:var(--soft);font-size:13px;line-height:1.6;margin-top:16px}.section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px}.controls{display:grid;grid-template-columns:2fr 1fr 1fr;gap:9px;margin:14px 0}.field{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:11px;background:var(--bg);color:var(--text);outline:none;font:inherit;font-size:13px}.field:focus{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 15%,transparent)}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px}table{width:100%;border-collapse:collapse;min-width:850px;font-size:13px}th{position:sticky;top:0;background:var(--soft);text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);padding:13px 12px;z-index:1}td{padding:13px 12px;border-top:1px solid var(--line);vertical-align:top;line-height:1.5}tbody tr:hover{background:color-mix(in srgb,var(--accent) 5%,var(--panel))}td:nth-child(1){width:50px;color:var(--muted)}td:nth-child(2){min-width:260px}td:nth-child(3){min-width:300px}.pill{display:inline-block;padding:5px 8px;border-radius:7px;background:var(--soft);color:var(--accent);font-size:11px;font-weight:800;white-space:nowrap}.difficulty{color:var(--text);background:var(--bg);border:1px solid var(--line)}.table-foot{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-top:13px;color:var(--muted);font-size:12px}.pages{display:flex;gap:6px}.pages button{padding:7px 10px}.pages button:disabled{opacity:.4;cursor:not-allowed}.section{margin-top:18px}.category-table{margin-top:16px}.category-table table{min-width:480px}.empty{text-align:center;padding:35px;color:var(--muted)}.footer{text-align:center;color:var(--muted);font-size:12px;margin:24px 0 0}.note{font-size:12px;color:var(--muted);line-height:1.6}
@media(max-width:900px){.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.layout{grid-template-columns:1fr}.controls{grid-template-columns:1fr 1fr}.controls .field:first-child{grid-column:1/-1}}
@media(max-width:540px){.wrap{padding:14px 12px 32px}.hero{padding:23px 19px;border-radius:18px}.metrics{gap:9px}.metric{padding:14px}.metric strong{font-size:25px}.topbar{align-items:flex-start;flex-direction:column}.controls{grid-template-columns:1fr}.controls .field:first-child{grid-column:auto}.panel{padding:14px}}
@media print{body{background:white;color:#111}.topbar .actions,.controls,.pages,.hero button{display:none}.wrap{max-width:none;padding:0}.hero{background:#eee;color:#111;box-shadow:none}.hero p{color:#333}.metric,.panel{box-shadow:none;break-inside:avoid}}
.dg-no{display:inline-block;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);background:var(--soft);padding:3px 8px;border-radius:6px;margin-bottom:8px}
.concl{border-left:4px solid var(--accent2);background:var(--soft);border-radius:0 12px 12px 0;padding:12px 14px;font-size:13px;line-height:1.65;margin-top:16px}
.concl>strong:first-child{color:var(--accent)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
.grid2>.panel{display:flex;flex-direction:column}.grid2>.panel .concl{margin-top:auto}.grid2>.panel .sub{margin-bottom:14px}
.plain td:nth-child(1){width:auto;min-width:190px;color:var(--text)}.plain td:nth-child(2),.plain td:nth-child(3){min-width:0}
.hm table{min-width:640px}.plain td.c,.plain th.c{text-align:center;font-variant-numeric:tabular-nums}.plain td.c{font-weight:700}
.legend-inline{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin:0 0 12px}
.sw{width:10px;height:10px;border-radius:3px;display:inline-block;margin-right:6px;vertical-align:-1px}
.donut-wrap{display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin-bottom:6px}.donut-wrap svg{flex:0 0 auto;width:190px;max-width:100%}
.legend{flex:1;min-width:190px;font-size:12px}.legend div{display:flex;justify-content:space-between;gap:10px;margin:8px 0}.legend span:first-child{overflow:hidden;text-overflow:ellipsis}
.waffle-wrap{display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin-bottom:6px}
.waffle{display:grid;grid-template-columns:repeat(10,1fr);gap:4px;width:240px;max-width:100%}.waffle i{aspect-ratio:1;border-radius:4px;display:block}
.cloud{display:flex;flex-wrap:wrap;gap:6px 16px;align-items:baseline;justify-content:center;padding:10px 0}
.cloud span{font-weight:800;line-height:1.15;cursor:default;color:var(--accent)}.cloud span:nth-child(3n+2){color:var(--accent2)}.cloud span:nth-child(3n){color:var(--text)}
.stack{display:flex;height:26px;border-radius:99px;overflow:hidden;background:var(--line);font-size:11px;font-weight:800;color:#fff}
.stack span{display:flex;align-items:center;justify-content:center;white-space:nowrap}
.lang-row{margin:16px 0}.lang-row>strong{display:block;font-size:13px;margin-bottom:7px}
.lens-note{font-size:11px;color:var(--muted);margin-left:4px}
.audit-list{font-size:13px;line-height:1.7;margin:14px 0 0;padding-left:18px;color:var(--text)}
.dup-wrap{max-height:380px}
.flash-controls{display:grid;grid-template-columns:1.2fr 1fr auto auto;gap:9px;margin:14px 0}
.flashcard{min-height:230px;border:1px solid var(--line);border-radius:18px;padding:26px;background:var(--bg);cursor:pointer;display:flex;flex-direction:column;justify-content:center;gap:14px;text-align:center;transition:.2s;outline:none}
.flashcard:hover,.flashcard:focus{border-color:var(--accent)}.flashcard.back{background:var(--soft)}
.fl-meta{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}.fl-text{font-size:18px;line-height:1.6;font-weight:600}.fl-text.q{font-size:20px}.fl-hint,.fl-tag{font-size:12px;color:var(--muted)}.fl-tag{font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
.flash-nav{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:14px}
.btn-ok{background:#26b99a;border-color:#26b99a;color:#fff}.btn-no{background:#f59e0b;border-color:#f59e0b;color:#fff}
.flash-stats{margin-top:14px;font-size:12px;color:var(--muted)}.progress{height:8px;background:var(--line);border-radius:99px;overflow:hidden;margin-top:7px}.progress>div{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));width:0;transition:.25s}
@media(max-width:900px){.grid2{grid-template-columns:1fr}.flash-controls{grid-template-columns:1fr 1fr}}
@media(max-width:540px){.flash-controls{grid-template-columns:1fr}.fl-text.q{font-size:17px}.flashcard{padding:18px}}
@media print{.flash-controls,.flash-nav{display:none}.concl{background:#f2f2f2;break-inside:avoid}}
</style>
</head>
<body>
<div class="wrap">
  <div class="topbar"><div class="brand">DATA<span style="color:var(--accent)">LAB</span> / Perangkat Lunak</div><div class="actions"><button id="themeBtn" type="button">☾ Mode gelap</button><button onclick="window.print()" type="button">⎙ Cetak / PDF</button><button id="csvBtn" type="button">↓ Ekspor CSV</button></div></div>
  <header class="hero"><div class="eyebrow">Dashboard interaktif • Analisis data</div><h1>Penyajian Data<br>Pertanyaan Perangkat Lunak</h1><p>Jelajahi ringkasan data, distribusi kategori, tingkat kesulitan, analisis lanjutan, audit kualitas data, mode flashcard, dan seluruh data mentah. Gunakan pencarian serta filter untuk menemukan pertanyaan tertentu.</p></header>
  <section class="metrics" id="metrics"></section>
  <section class="layout section">
    <div class="panel"><div class="dg-no">Diagram 1</div><h2>Frekuensi berdasarkan kategori</h2><p class="sub">Jumlah pertanyaan pada setiap kategori, diurutkan dari yang terbanyak.</p><div id="categoryChart"></div><div class="note">Grafik menampilkan 10 kategori teratas agar lebih mudah dibaca. Tabel frekuensi lengkap tersedia di bawah.</div><div class="concl" id="c1"></div></div>
    <div class="panel"><div class="dg-no">Diagram 2</div><h2>Distribusi tingkat kesulitan</h2><p class="sub">Perbandingan jumlah pertanyaan mudah, menengah, dan sulit.</p><div id="difficultyChart"></div><div class="concl" id="insight"></div></div>
  </section>
  <section class="panel section category-table"><div class="section-head"><div><div class="dg-no">Tabel 1</div><h2>Tabel frekuensi kategori</h2><p class="sub">Jumlah dan persentase dari seluruh data.</p></div></div><div class="table-wrap"><table><thead><tr><th>Kategori</th><th>Frekuensi</th><th>Persentase</th></tr></thead><tbody id="categoryTable"></tbody></table></div><div class="concl" id="c2"></div></section>
    <section class="panel section hm"><div class="dg-no">Diagram 3</div><h2>Peta panas: kategori × tingkat kesulitan</h2><p class="sub">Jumlah pertanyaan pada setiap pertemuan kategori dan tingkat kesulitan. Warna makin pekat berarti porsi di kategori itu makin besar.</p>
    <div class="legend-inline"><span><i class="sw" style="background:#26b99a"></i>Mudah</span><span><i class="sw" style="background:#7566ed"></i>Menengah</span><span><i class="sw" style="background:#f59e0b"></i>Sulit</span></div>
    <div class="table-wrap"><table class="plain"><thead><tr><th>Kategori</th><th class="c">Mudah</th><th class="c">Menengah</th><th class="c">Sulit</th><th class="c">Total</th><th class="c">% Sulit</th></tr></thead><tbody id="hmBody"></tbody></table></div>
    <div class="concl" id="c3"></div></section>
 
  <section class="grid2">
    <div class="panel"><div class="dg-no">Diagram 4</div><h2>Komposisi bidang (kategori digabung)</h2><p class="sub">22 kategori awal dikelompokkan menjadi bidang besar agar pola lebih mudah dibaca.</p><div class="donut-wrap" id="donut"></div><div class="concl" id="c4"></div></div>
    <div class="panel"><div class="dg-no">Diagram 5</div><h2>Waffle chart: komposisi tingkat kesulitan</h2><p class="sub">100 kotak mewakili seluruh pertanyaan; setiap kotak setara <span id="waffleUnit"></span> pertanyaan.</p><div class="waffle-wrap" id="waffle"></div><div class="concl" id="c5"></div></div>
  </section>
 
  <section class="grid2">
    <div class="panel"><div class="dg-no">Diagram 6</div><h2>Panjang jawaban menurut tingkat kesulitan</h2><p class="sub">Rata-rata jumlah kata pada kolom jawaban untuk tiap tingkat kesulitan.</p><div id="lenChart"></div><div class="concl" id="c6"></div></div>
    <div class="panel"><div class="dg-no">Diagram 7</div><h2>Jenis kata tanya pada pertanyaan</h2><p class="sub">Kata pertama pertanyaan menunjukkan bentuk soal (penjelasan konsep atau tugas rancang/implementasi).</p><div id="qwChart"></div><div class="concl" id="c7"></div></div>
  </section>
 
  <section class="grid2" style="grid-template-columns:1fr">
    <div class="panel"><div class="dg-no">Diagram 8</div><h2>Awan istilah teknis</h2><p class="sub">Istilah teknis yang paling sering disebut dalam pertanyaan dan jawaban. Ukuran huruf sebanding dengan jumlah baris yang memuatnya.</p><div class="cloud" id="cloud"></div><div class="concl" id="c8"></div></div>
 
  </section>
 
  <section class="panel section"><div class="dg-no">Diagram 9</div><h2>Audit kualitas data</h2><p class="sub">Pemeriksaan duplikasi, ketimpangan kategori, dan konsistensi label sebelum data dipakai untuk keperluan lanjutan.</p>
    <div class="metrics" id="auditMetrics" style="margin:0 0 16px"></div>
    <h2 style="font-size:14px">Pertanyaan yang muncul lebih dari satu kali</h2><p class="sub" style="margin-bottom:10px">Pertanyaan dianggap sama jika teksnya identik (huruf besar/kecil diabaikan).</p>
    <div class="table-wrap dup-wrap"><table class="plain"><thead><tr><th>Pertanyaan</th><th class="c">Muncul</th><th>No. baris</th><th>Konsistensi label</th></tr></thead><tbody id="dupBody"></tbody></table></div>
    <ul class="audit-list" id="overlapList"></ul>
    <div class="concl" id="c10"></div></section>
 
  <section class="panel section"><div class="section-head"><div><h2>Data mentah</h2><p class="sub">Semua baris data sumber disertakan. Cari kata, filter kategori atau tingkat kesulitan, lalu ekspor hasil yang sedang ditampilkan.</p></div><span class="pill" id="recordCount"></span></div>
    <div class="controls"><input class="field" id="search" type="search" placeholder="⌕ Cari pertanyaan, jawaban, kategori..."><select class="field" id="categoryFilter"><option value="">Semua kategori</option></select><select class="field" id="difficultyFilter"><option value="">Semua tingkat kesulitan</option></select></div>
    <div class="table-wrap"><table><thead><tr><th>No.</th><th>Pertanyaan</th><th>Jawaban</th><th>Kategori</th><th>Tingkat Kesulitan</th></tr></thead><tbody id="rawTable"></tbody></table></div>
    <div class="table-foot"><span id="pageInfo"></span><div class="pages"><button id="prevBtn" type="button">← Sebelumnya</button><button id="nextBtn" type="button">Berikutnya →</button></div></div>
  </section>
    <section class="panel section" id="flashSec"><div class="dg-no">Mode belajar</div><h2>Flashcard &amp; latihan mandiri</h2><p class="sub">Pilih kategori dan tingkat kesulitan, klik kartu untuk melihat jawaban, lalu tandai Paham atau Belum. Tombol set seimbang mengambil 20 soal dari semua bidang secara bergantian.</p>
    <div class="flash-controls"><select class="field" id="fcCat"><option value="">Semua kategori</option></select><select class="field" id="fcDiff"><option value="">Semua tingkat kesulitan</option></select><button type="button" id="fcShuffle">⤮ Acak</button><button type="button" id="fcBalanced">☰ Set seimbang (20)</button></div>
    <div class="flashcard" id="flashCard" tabindex="0" role="button" aria-label="Kartu: klik untuk membalik"></div>
    <div class="flash-nav"><button type="button" id="fcPrev">← Sebelumnya</button><button type="button" id="fcFlip">⟲ Balik kartu</button><button type="button" id="fcNext">Berikutnya →</button><button type="button" class="btn-ok" id="fcOk">✓ Paham</button><button type="button" class="btn-no" id="fcNo">↻ Belum</button></div>
    <div class="flash-stats" id="flashStats"></div>
    <div class="concl" id="flashConcl"></div></section>
 
  <section class="panel section"><h2>Kesimpulan singkat</h2><p id="conclusion" style="line-height:1.7;margin-bottom:0"></p></section>
  <p class="footer">Dashboard dibuat dari file data pertanyaan perangkat lunak. Frekuensi dihitung berdasarkan data yang tersedia.</p>
</div>
<script>
const rows = [{"No.": 1, "Pertanyaan": "Apa perbedaan antara kompilasi dan interpretasi?", "Jawaban": "Kompilasi menerjemahkan seluruh kode sumber menjadi kode mesin dan menghasilkan berkas yang dapat dijalankan. Interpretasi menjalankan kode baris demi baris tanpa membuat berkas executable terlebih dahulu.", "Kategori": "Pemrograman Umum", "Tingkat Kesulitan": "Menengah"}, {"No.": 2, "Pertanyaan": "Jelaskan konsep polimorfisme.", "Jawaban": "Polimorfisme memungkinkan objek dari kelas berbeda diperlakukan sebagai objek dari kelas induk yang sama. Hal ini memungkinkan penggunaan method overriding.", "Kategori": "Pemrograman Umum", "Tingkat Kesulitan": "Menengah"}, {"No.": 3, "Pertanyaan": "Jelaskan enkapsulasi dan berikan contohnya.", "Jawaban": "Enkapsulasi menggabungkan data dan metode dalam sebuah kelas serta membatasi akses langsung ke data. Contohnya, data dibuat private dan diakses melalui metode public.", "Kategori": "Pemrograman Umum", "Tingkat Kesulitan": "Sulit"}, {"No.": 4, "Pertanyaan": "Apa itu kelas abstrak, dan apa bedanya dengan antarmuka (interface)?", "Jawaban": "Kelas abstrak tidak dapat dibuat menjadi objek secara langsung dan dapat memiliki metode abstrak maupun metode yang sudah berisi implementasi. Interface umumnya mendefinisikan kontrak metode yang harus diterapkan oleh kelas.", "Kategori": "Pemrograman Umum", "Tingkat Kesulitan": "Menengah"}, {"No.": 5, "Pertanyaan": "Jelaskan prinsip-prinsip Pemrograman Berorientasi Objek (OOP).", "Jawaban": "Prinsip OOP meliputi enkapsulasi, pewarisan (inheritance), polimorfisme, dan abstraksi. Prinsip ini membantu membuat kode lebih terstruktur dan mudah dipelihara.", "Kategori": "Pemrograman Umum", "Tingkat Kesulitan": "Menengah"}, {"No.": 6, "Pertanyaan": "Apa tujuan dari constructor?", "Jawaban": "Constructor digunakan untuk menginisialisasi nilai atau properti objek saat objek dibuat.", "Kategori": "Pemrograman Umum", "Tingkat Kesulitan": "Menengah"}, {"No.": 7, "Pertanyaan": "Jelaskan perbedaan memori stack dan heap.", "Jawaban": "Memori stack menyimpan variabel lokal dan pemanggilan fungsi dengan pola LIFO (yang terakhir masuk, pertama keluar). Memori heap digunakan untuk alokasi memori dinamis dan pengelolaannya dapat dilakukan secara manual atau melalui garbage collector.", "Kategori": "Pemrograman Umum", "Tingkat Kesulitan": "Menengah"}, {"No.": 8, "Pertanyaan": "Apa itu design pattern? Sebutkan beberapa contohnya.", "Jawaban": "Design pattern adalah pola solusi untuk masalah desain yang sering muncul. Contohnya Singleton, Factory, Observer, dan MVC.", "Kategori": "Pemrograman Umum", "Tingkat Kesulitan": "Menengah"}, {"No.": 9, "Pertanyaan": "Jelaskan istilah DRY (Don't Repeat Yourself) dalam pengembangan perangkat lunak.", "Jawaban": "DRY (Don't Repeat Yourself) berarti menghindari penulisan kode yang berulang dengan menggunakan kembali kode yang sudah tersedia.", "Kategori": "Pemrograman Umum", "Tingkat Kesulitan": "Menengah"}, {"No.": 10, "Pertanyaan": "Apa itu prinsip SOLID?", "Jawaban": "SOLID adalah lima prinsip desain OOP, yaitu Single Responsibility, Open/Closed, Liskov Substitution, Interface Segregation, dan Dependency Inversion.", "Kategori": "General Program", "Tingkat Kesulitan": "Sulit"}, {"No.": 11, "Pertanyaan": "Apa perbedaan array dan linked list?", "Jawaban": "Array menyimpan elemen dalam urutan memori yang berdekatan dan biasanya memiliki ukuran yang ditentukan saat dibuat. Linked list terdiri dari node yang menyimpan data dan referensi ke node lain sehingga ukurannya lebih fleksibel.", "Kategori": "Struktur Data", "Tingkat Kesulitan": "Mudah"}, {"No.": 12, "Pertanyaan": "Jelaskan kompleksitas waktu suatu algoritma.", "Jawaban": "Kompleksitas waktu mengukur pertumbuhan waktu eksekusi algoritma berdasarkan ukuran input. Biasanya dinyatakan dengan notasi Big O.", "Kategori": "Struktur Data", "Tingkat Kesulitan": "Sulit"}, {"No.": 13, "Pertanyaan": "Jelaskan perbedaan binary search tree dan hash table.", "Jawaban": "Binary search tree menyimpan data dalam struktur pohon yang mempertahankan urutan. Hash table memetakan kunci ke nilai agar pencarian cepat, tetapi tidak mempertahankan urutan data.", "Kategori": "Struktur Data", "Tingkat Kesulitan": "Menengah"}, {"No.": 14, "Pertanyaan": "Apa itu linked list dan bagaimana cara kerjanya?", "Jawaban": "Linked list adalah kumpulan node. Setiap node menyimpan data dan referensi ke node berikutnya, sehingga penambahan atau penghapusan elemen dapat dilakukan secara fleksibel.", "Kategori": "Struktur Data", "Tingkat Kesulitan": "Menengah"}, {"No.": 15, "Pertanyaan": "Jelaskan konsep rekursi.", "Jawaban": "Rekursi terjadi ketika sebuah fungsi memanggil dirinya sendiri untuk menyelesaikan masalah yang lebih kecil. Kondisi dasar (base case) diperlukan agar proses berhenti.", "Kategori": "Struktur Data", "Tingkat Kesulitan": "Menengah"}, {"No.": 16, "Pertanyaan": "Apa itu Big O notation, dan why is it important?", "Jawaban": "Big O notation describes the upper bound of algorithm time complexity, important untuk comparing efficiency dan growth rates.", "Kategori": "Struktur Data", "Tingkat Kesulitan": "Menengah"}, {"No.": 17, "Pertanyaan": "Bagaimana cara Anda perform a binary search on a sorted array?", "Jawaban": "Binary search divides the search interval in half, repeatedly comparing the middle element untuk the target.", "Kategori": "Struktur Data", "Tingkat Kesulitan": "Sulit"}, {"No.": 18, "Pertanyaan": "Discuss the keuntungan dan disadvantages of different sorting algoritmas.", "Jawaban": "Sorting algorithms vary in time/space complexity dan stability. Quick Sort dan Merge Sort adalah fast but more complex; Insertion dan Bubble Sort adalah simple but slower.", "Kategori": "Struktur Data", "Tingkat Kesulitan": "Menengah"}, {"No.": 19, "Pertanyaan": "Jelaskan bagaimana a hash table works.", "Jawaban": "Sebuah hash table uses a hash function untuk map keys untuk values in an array, allowing fast O(1) access.", "Kategori": "Struktur Data", "Tingkat Kesulitan": "Menengah"}, {"No.": 20, "Pertanyaan": "Apa itu dynamic programming?", "Jawaban": "Dynamic programming solves complex problems dengan dividing them into smaller subproblems, avoiding redundant calculations.", "Kategori": "Struktur Data", "Tingkat Kesulitan": "Sulit"}, {"No.": 21, "Pertanyaan": "Apa perbedaan antara Java dan JavaScript?", "Jawaban": "Java adalah compiled, statically-typed language used untuk server-side, mobile, dan desktop apps. JavaScript is an interpreted, dynamically-typed language untuk web development.", "Kategori": "Languages and Frameworks", "Tingkat Kesulitan": "Menengah"}, {"No.": 22, "Pertanyaan": "Jelaskan the MVC architectural pattern.", "Jawaban": "MVC divides an aplikasi into Model (data), View (UI), dan Controller (input handling), promoting separation of concerns.", "Kategori": "Languages and Frameworks", "Tingkat Kesulitan": "Menengah"}, {"No.": 23, "Pertanyaan": "Apa itu a RESTful API?", "Jawaban": "RESTful API adalah web service implementation menggunakan HTTP methods untuk perform CRUD operations on resources, adhering untuk stateless, client-server architecture.", "Kategori": "Languages and Frameworks", "Tingkat Kesulitan": "Menengah"}, {"No.": 24, "Pertanyaan": "Jelaskan the use of \"this\" keyword dalam JavaScript.", "Jawaban": "\"this\" in JavaScript refers untuk the execution context, varying based on function calling, global scope, atau event handlers.", "Kategori": "Languages and Frameworks", "Tingkat Kesulitan": "Menengah"}, {"No.": 25, "Pertanyaan": "Apa itu a closure dalam pemrograman?", "Jawaban": "Sebuah closure adalah function dengan access untuk its outer scope variables even after the outer function has executed.", "Kategori": "Languages and Frameworks", "Tingkat Kesulitan": "Menengah"}, {"No.": 26, "Pertanyaan": "Apa saja the perbedaans between Python 2 dan Python 3?", "Jawaban": "Python 3 has print as a function, true division, Unicode support dengan default, dan different syntax untuk exceptions, unlike Python 2.", "Kategori": "Languages and Frameworks", "Tingkat Kesulitan": "Menengah"}, {"No.": 27, "Pertanyaan": "Jelaskan peran a package manager like npm or pip.", "Jawaban": "Package managers manage installation, update, dan dependency resolution of libraries, simplifying library management in development.", "Kategori": "Languages and Frameworks", "Tingkat Kesulitan": "Sulit"}, {"No.": 28, "Pertanyaan": "Jelaskan konsep multi-threading in Java.", "Jawaban": "Multi-threading in Java memungkinkan concurrent execution of multiple threads, improving aplikasi responsiveness dan kinerja.", "Kategori": "Languages and Frameworks", "Tingkat Kesulitan": "Menengah"}, {"No.": 29, "Pertanyaan": "Apa itu a Singleton pattern?", "Jawaban": "Singleton memastikan a class has only one instance dan menyediakan a global access point untuk it, useful untuk shared resources.", "Kategori": "Languages and Frameworks", "Tingkat Kesulitan": "Menengah"}, {"No.": 30, "Pertanyaan": "Apa itu a virtual function in C++?", "Jawaban": "Virtual functions in C++ allow derived classes untuk override them, enabling runtime polymorphism dan dynamic method dispatch.", "Kategori": "Languages and Frameworks", "Tingkat Kesulitan": "Menengah"}, {"No.": 31, "Pertanyaan": "Apa itu a basis data index, dan why is it important?", "Jawaban": "Sebuah basis data index speeds up pengambilan data, similar untuk a book's index, improving query kinerja.", "Kategori": "Database and SQL", "Tingkat Kesulitan": "Menengah"}, {"No.": 32, "Pertanyaan": "Jelaskan the perbedaans between SQL dan NoSQL basis datas.", "Jawaban": "SQL basis datas use structured query language dengan a predefined schema; NoSQL basis datas store schema-less data dengan flexible models.", "Kategori": "Database and SQL", "Tingkat Kesulitan": "Menengah"}, {"No.": 33, "Pertanyaan": "Apa itu a foreign key in a basis data?", "Jawaban": "Sebuah foreign key links two tables dengan referring untuk the primary key in another table, ensuring referential integrity.", "Kategori": "Database and SQL", "Tingkat Kesulitan": "Menengah"}, {"No.": 34, "Pertanyaan": "Jelaskan the ACID properties in basis data transactions.", "Jawaban": "ACID: Atomicity (indivisible transactions), Consistency (consistent state transitions), Isolation (independent transactions), Durability (persisted changes).", "Kategori": "Database and SQL", "Tingkat Kesulitan": "Sulit"}, {"No.": 35, "Pertanyaan": "Bagaimana cara Anda optimize a SQL query for better kinerja?", "Jawaban": "Optimize menggunakan indexes, efisien SQL, limiting pengambilan data, analyzing query kinerja, dan considering denormalization.", "Kategori": "Database and SQL", "Tingkat Kesulitan": "Mudah"}, {"No.": 36, "Pertanyaan": "Apa itu normalization in basis data design?", "Jawaban": "Normalization organizes data into separate tables untuk reduce redundancy dan improve integrity, following normalization forms.", "Kategori": "Database and SQL", "Tingkat Kesulitan": "Sulit"}, {"No.": 37, "Pertanyaan": "Jelaskan perbedaan antara INNER JOIN dan LEFT JOIN in SQL.", "Jawaban": "INNER JOIN returns matching rows dari both tables; LEFT JOIN returns all rows dari the left table dan matching rows dari the right.", "Kategori": "Database and SQL", "Tingkat Kesulitan": "Menengah"}, {"No.": 38, "Pertanyaan": "Apa itu a stored procedure, dan when would you use one?", "Jawaban": "Stored procedures adalah precompiled SQL statements untuk data manipulation dan logic, used untuk repetitive tasks dan improving kinerja.", "Kategori": "Database and SQL", "Tingkat Kesulitan": "Menengah"}, {"No.": 39, "Pertanyaan": "Apa itu basis data denormalization, dan when is it appropriate?", "Jawaban": "Denormalization introduces redundancy untuk kinerja, useful in read-heavy scenarios at the expense of storage dan complexity.", "Kategori": "Database and SQL", "Tingkat Kesulitan": "Menengah"}, {"No.": 40, "Pertanyaan": "Discuss the keuntungan dan disadvantages of using an ORM tool.", "Jawaban": "ORM simplifies basis data interactions dan is language-agnostic. It can introduce kinerja overhead dan may limit basis data features.", "Kategori": "Database and SQL", "Tingkat Kesulitan": "Menengah"}, {"No.": 41, "Pertanyaan": "Apa itu the Document Object Model (DOM)?", "Jawaban": "DOM adalah tree-like representation of a web page's structure, allowing manipulation of content, structure, dan style via programming languages.", "Kategori": "Web Development", "Tingkat Kesulitan": "Sulit"}, {"No.": 42, "Pertanyaan": "Jelaskan perbedaan antara HTTP dan HTTPS.", "Jawaban": "HTTP is an unsecured data transmission protocol; HTTPS is secure, encrypting data in transit menggunakan SSL/TLS.", "Kategori": "Web Development", "Tingkat Kesulitan": "Menengah"}, {"No.": 43, "Pertanyaan": "Apa itu CORS (Cross-Origin Resource Sharing)?", "Jawaban": "CORS adalah keamanan measure allowing atau restricting resources requested dari another domain, managed via HTTP headers.", "Kategori": "Web Development", "Tingkat Kesulitan": "Menengah"}, {"No.": 44, "Pertanyaan": "Jelaskan the purpose dari web server like Apache or Nginx.", "Jawaban": "Web servers handle HTTP requests, serve content, manage keamanan, routing, dan can act as reverse proxies untuk aplikasi servers.", "Kategori": "Web Development", "Tingkat Kesulitan": "Menengah"}, {"No.": 45, "Pertanyaan": "Apa itu a cookie, dan bagaimana cara kerjanya?", "Jawaban": "Cookies adalah data stored on the user's computer dengan the web server, sent dengan HTTP requests untuk session management, tracking, dan storing preferences.", "Kategori": "Web Development", "Tingkat Kesulitan": "Sulit"}, {"No.": 46, "Pertanyaan": "Apa itu a session dalam pengembangan web?", "Jawaban": "Sebuah session maintains stateful information di berbagai multiple HTTP requests, typically untuk user authentication dan penyimpanan data.", "Kategori": "Web Development", "Tingkat Kesulitan": "Menengah"}, {"No.": 47, "Pertanyaan": "Jelaskan konsep responsive web design.", "Jawaban": "Responsive design memastikan web content functions di berbagai different devices dan screen sizes, menggunakan CSS media queries dan flexible layouts.", "Kategori": "Web Development", "Tingkat Kesulitan": "Menengah"}, {"No.": 48, "Pertanyaan": "Jelaskan the perbedaans between GET dan POST requests.", "Jawaban": "GET requests retrieve data dan include parameters in the URL; POST requests send data untuk the server, encapsulating data in the request body.", "Kategori": "Web Development", "Tingkat Kesulitan": "Menengah"}, {"No.": 49, "Pertanyaan": "Apa itu the importance of SEO dalam pengembangan web?", "Jawaban": "SEO enhances a website's visibility in search engine results, improving organic lalu lintas dan user reach through optimized content dan structure.", "Kategori": "Web Development", "Tingkat Kesulitan": "Menengah"}, {"No.": 50, "Pertanyaan": "Bagaimana a web browser render a web page?", "Jawaban": "Browsers parse HTML untuk create a DOM, fetch resources, build a rendering tree, apply CSS, calculate layout, dan paint the page on the screen.", "Kategori": "Web Development", "Tingkat Kesulitan": "Menengah"}, {"No.": 51, "Pertanyaan": "Apa itu unit testing, dan why is it important?", "Jawaban": "Unit testing evaluates individual code components, ensuring correctness dan facilitating early defect detection.", "Kategori": "Software Testing", "Tingkat Kesulitan": "Menengah"}, {"No.": 52, "Pertanyaan": "Jelaskan perbedaan antara black-box dan white-box testing.", "Jawaban": "Black-box tests functionality without internal code knowledge; white-box tests internal code logic dan structure.", "Kategori": "Software Testing", "Tingkat Kesulitan": "Sulit"}, {"No.": 53, "Pertanyaan": "Apa itu regression testing?", "Jawaban": "Regression testing memastikan new code changes don't break existing features, maintaining functionality over updates.", "Kategori": "Software Testing", "Tingkat Kesulitan": "Mudah"}, {"No.": 54, "Pertanyaan": "Jelaskan the purpose of code reviews.", "Jawaban": "Code reviews identify defects, improve quality, enforce standards, dan facilitate knowledge sharing.", "Kategori": "Software Testing", "Tingkat Kesulitan": "Sulit"}, {"No.": 55, "Pertanyaan": "Apa itu continuous integration (CI) dan continuous delivery (CD)?", "Jawaban": "CI involves frequent code integration dan testing; CD extends CI dengan deploying changes untuk production automatically after testing.", "Kategori": "Software Testing", "Tingkat Kesulitan": "Menengah"}, {"No.": 56, "Pertanyaan": "Jelaskan konsep code coverage in testing.", "Jawaban": "Code coverage measures the extent of code tested, assessing test thoroughness dan identifying untested areas.", "Kategori": "Software Testing", "Tingkat Kesulitan": "Menengah"}, {"No.": 57, "Pertanyaan": "Apa itu a test case dan how do you write one?", "Jawaban": "Sebuah test case outlines test conditions, inputs, dan expected results, structured dengan objective, steps, dan documentation.", "Kategori": "Software Testing", "Tingkat Kesulitan": "Menengah"}, {"No.": 58, "Pertanyaan": "Apa itu load testing, dan why is it necessary?", "Jawaban": "Load testing evaluates sistem kinerja under expected load conditions, identifying bottlenecks dan kemampuan menangani pertumbuhan skala issues.", "Kategori": "Software Testing", "Tingkat Kesulitan": "Menengah"}, {"No.": 59, "Pertanyaan": "Jelaskan the perbedaans between manual dan automated testing.", "Jawaban": "Manual testing is human-driven; suitable untuk exploratory dan UX testing. Automated testing uses tools untuk repetitive tasks; suitable untuk regression dan kinerja testing.", "Kategori": "Software Testing", "Tingkat Kesulitan": "Sulit"}, {"No.": 60, "Pertanyaan": "Apa itu a bug tracking sistem?", "Jawaban": "Sebuah bug tracking sistem logs, manages, dan resolves issues in software development, ensuring sistematic problem handling.", "Kategori": "Software Testing", "Tingkat Kesulitan": "Menengah"}, {"No.": 61, "Pertanyaan": "Apa itu Git, dan bagaimana cara kerjanya?", "Jawaban": "Git adalah terdistribusi version control sistem untuk tracking changes in source code, allowing collaborative work dan branch management.", "Kategori": "Version Control", "Tingkat Kesulitan": "Menengah"}, {"No.": 62, "Pertanyaan": "Jelaskan perbedaan antara Git dan SVN (Subversion).", "Jawaban": "Git is terdistribusi, dengan local repository copies; SVN is centralized, requiring jaringan connectivity untuk repository access.", "Kategori": "Version Control", "Tingkat Kesulitan": "Sulit"}, {"No.": 63, "Pertanyaan": "Apa itu a merge conflict, dan how do you resolve it in Git?", "Jawaban": "Merge conflicts occur when changes in different branches clash. Resolve dengan manually editing files dan committing the result.", "Kategori": "Version Control", "Tingkat Kesulitan": "Menengah"}, {"No.": 64, "Pertanyaan": "Jelaskan the purpose of branching in version control.", "Jawaban": "Branching isolates development work without affecting other parts of the repository, aiding in feature development dan experimentation.", "Kategori": "Version Control", "Tingkat Kesulitan": "Menengah"}, {"No.": 65, "Pertanyaan": "Apa itu a pull request (PR), dan bagaimana cara kerjanya?", "Jawaban": "Sebuah PR adalah request untuk merge code dari one branch untuk another, facilitating code review dan discussion before integration.", "Kategori": "Version Control", "Tingkat Kesulitan": "Menengah"}, {"No.": 66, "Pertanyaan": "Bagaimana cara Anda handle code conflicts in a team project?", "Jawaban": "Resolve code conflicts through communication, careful review, manual merging, testing, dan documenting resolutions.", "Kategori": "Version Control", "Tingkat Kesulitan": "Menengah"}, {"No.": 67, "Pertanyaan": "Apa itu code refactoring, dan why is it important?", "Jawaban": "Refactoring meningkatkan code structure dan readability without altering functionality, enhancing maintainability dan quality.", "Kategori": "Version Control", "Tingkat Kesulitan": "Menengah"}, {"No.": 68, "Pertanyaan": "Jelaskan the role of Git branching strategies like GitFlow.", "Jawaban": "GitFlow organizes branches dan releases, defining naming conventions dan branch purposes untuk structured dan organized development.", "Kategori": "Version Control", "Tingkat Kesulitan": "Menengah"}, {"No.": 69, "Pertanyaan": "Apa itu Git rebase, dan when would you use it?", "Jawaban": "Git rebase re-applies commits onto another base untuk a cleaner history. Gunakan dengan caution untuk maintain a linear project history.", "Kategori": "Version Control", "Tingkat Kesulitan": "Sulit"}, {"No.": 70, "Pertanyaan": "Discuss the keuntungan of distributed version control sistems.", "Jawaban": "Distributed sistems allow offline work, flexible branching/merging, faster operations, redundancy, dan collaborative workflows.", "Kategori": "Version Control", "Tingkat Kesulitan": "Menengah"}, {"No.": 71, "Pertanyaan": "Jelaskan the concept of microservices architecture.", "Jawaban": "Microservices architecture consists of small, independent services communicating via APIs, each responsible untuk specific functionality, promoting kemampuan menangani pertumbuhan skala dan maintenance.", "Kategori": "Perancangan Sistem", "Tingkat Kesulitan": "Menengah"}, {"No.": 72, "Pertanyaan": "Apa itu a load balancer, dan why is it used in web aplikasis?", "Jawaban": "Sebuah load balancer distributes incoming lalu lintas di berbagai servers, ensuring resource efficiency, fault tolerance, dan high availability.", "Kategori": "Perancangan Sistem", "Tingkat Kesulitan": "Menengah"}, {"No.": 73, "Pertanyaan": "Jelaskan the importance of caching in web aplikasis.", "Jawaban": "Caching stores frequently accessed data untuk faster retrieval, reducing backend load, improving kinerja, dan enhancing user experience.", "Kategori": "Perancangan Sistem", "Tingkat Kesulitan": "Menengah"}, {"No.": 74, "Pertanyaan": "Apa itu a CDN (Content Delivery Network)?", "Jawaban": "Sebuah CDN adalah jaringan of servers untuk delivering content efisienly untuk users based on geographic proximity, reducing latency dan load times.", "Kategori": "Perancangan Sistem", "Tingkat Kesulitan": "Menengah"}, {"No.": 75, "Pertanyaan": "Discuss the pros dan cons of monolithic dibandingkan microservices architecture.", "Jawaban": "Monolithic is simple but less scalable; microservices offer kemampuan menangani pertumbuhan skala dan flexibility but adalah complex untuk manage.", "Kategori": "Perancangan Sistem", "Tingkat Kesulitan": "Menengah"}, {"No.": 76, "Pertanyaan": "Apa itu a stateless dibandingkan stateful service?", "Jawaban": "Stateless services don't retain client data between requests; stateful services maintain client state, useful untuk sessions dan transactions.", "Kategori": "Perancangan Sistem", "Tingkat Kesulitan": "Sulit"}, {"No.": 77, "Pertanyaan": "Jelaskan konsep CAP theorem in distributed sistems.", "Jawaban": "CAP theorem states yang in a terdistribusi sistem, you cannot simultaneously guarantee Consistency, Availability, dan Partition Tolerance at all times.", "Kategori": "Perancangan Sistem", "Tingkat Kesulitan": "Mudah"}, {"No.": 78, "Pertanyaan": "Bagaimana cara Anda ensure data consistency in a distributed basis data?", "Jawaban": "Ensure consistency menggunakan strong consistency models, two-phase commits, optimistic concurrency control, dan conflict resolution strategies.", "Kategori": "Perancangan Sistem", "Tingkat Kesulitan": "Sulit"}, {"No.": 79, "Pertanyaan": "Jelaskan peran a reverse proxy in a web aplikasi.", "Jawaban": "Sebuah reverse proxy routes client requests untuk appropriate servers, providing load balancing, SSL termination, caching, dan keamanan.", "Kategori": "Perancangan Sistem", "Tingkat Kesulitan": "Menengah"}, {"No.": 80, "Pertanyaan": "Apa itu a message broker, dan when would you use one?", "Jawaban": "Sebuah message broker facilitates communication in terdistribusi sistems through asynchronous messaging, used in event-driven architectures dan high-volume scenarios.", "Kategori": "Perancangan Sistem", "Tingkat Kesulitan": "Menengah"}, {"No.": 81, "Pertanyaan": "Apa itu SQL injection, dan how can it be prevented?", "Jawaban": "SQL injection exploits vulnerabilities untuk execute malicious SQL. Prevent dengan parameterized queries, input validation, dan least privilege access.", "Kategori": "Keamanan", "Tingkat Kesulitan": "Menengah"}, {"No.": 82, "Pertanyaan": "Jelaskan konsep Cross-Site Scripting (XSS).", "Jawaban": "XSS injects malicious scripts into web apps, executed dengan users' browsers. Prevent dengan input validation, output encoding, dan CSP.", "Kategori": "Keamanan", "Tingkat Kesulitan": "Menengah"}, {"No.": 83, "Pertanyaan": "Apa itu two-factor authentication (2FA)?", "Jawaban": "2FSebuah adds extra keamanan dengan requiring two verification forms: something known (password) dan something possessed (device).", "Kategori": "Keamanan", "Tingkat Kesulitan": "Sulit"}, {"No.": 84, "Pertanyaan": "Jelaskan proses password hashing dan salting.", "Jawaban": "Hashing transforms passwords into hashes menggunakan algorithms; salting adds randomness, enhancing keamanan against attacks.", "Kategori": "Keamanan", "Tingkat Kesulitan": "Menengah"}, {"No.": 85, "Pertanyaan": "Apa itu OAuth, dan bagaimana cara kerjanya?", "Jawaban": "OAuth memungkinkan third-party app access untuk user data without exposing credentials, menggunakan access tokens untuk authorization.", "Kategori": "Keamanan", "Tingkat Kesulitan": "Menengah"}, {"No.": 86, "Pertanyaan": "Bagaimana cara Anda protect against session fixation attacks?", "Jawaban": "Protect dengan regenerating session IDs post-authentication, menggunakan unpredictable IDs, dan tying IDs untuk user authentication.", "Kategori": "Keamanan", "Tingkat Kesulitan": "Menengah"}, {"No.": 87, "Pertanyaan": "Jelaskan the principles of least privilege dan defense in depth.", "Jawaban": "Least privilege limits access rights; defense in depth layers keamanan. Both minimize attack surfaces dan provide redundancy.", "Kategori": "Keamanan", 